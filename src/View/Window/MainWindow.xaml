<local:View x:Class="WinMemoryCleaner.MainWindow"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:local="clr-namespace:WinMemoryCleaner"
            AllowsTransparency="True"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            DataContext="{Binding MainViewModel, Source={StaticResource ViewModelLocator}}"
            FlowDirection="{Binding Path=(local:Localizer.Language).Direction}"
            FocusManager.FocusedElement="{Binding ElementName=Optimize}"
            FontSize="{Binding FontSize}"
            Foreground="{DynamicResource SecondaryForeground}"
            Height="720"
            Icon="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico"
            MouseDown="OnWindowMouseDown"
            ResizeMode="NoResize"
            SnapsToDevicePixels="True"
            Title="{x:Static local:Constants+App.Title}"
            Topmost="{Binding AlwaysOnTop}"
            UseLayoutRounding="True"
            Width="560"
            WindowStartupLocation="CenterScreen"
            WindowStyle="None">
    <local:View.Resources>
        <SolidColorBrush x:Key="ShellBackground" Color="#080C12" />
        <SolidColorBrush x:Key="PanelBackground" Color="#131B25" />
        <SolidColorBrush x:Key="PanelBackgroundAlt" Color="#0E151D" />
        <SolidColorBrush x:Key="PanelBorder" Color="#3A4656" />
        <SolidColorBrush x:Key="MutedText" Color="#C7D2DF" />
        <SolidColorBrush x:Key="SoftText" Color="#F8FAFC" />
        <SolidColorBrush x:Key="GoodText" Color="#22C55E" />

        <Style x:Key="PanelCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="MetricValueText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SoftText}" />
        </Style>

        <Style x:Key="MetricLabelText" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
        </Style>

        <Style x:Key="WindowButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Width" Value="28" />
        </Style>

        <DataTemplate x:Key="BrushPickerItemTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Rectangle Fill="{Binding}" Height="14" RadiusX="3" RadiusY="3" Width="14" />
                <TextBlock Margin="6,0,0,0"
                           Text="{Binding Converter={StaticResource BrushToHexConverter}}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </local:View.Resources>

    <Border Background="{StaticResource ShellBackground}"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1"
            CornerRadius="8"
            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Height="24"
                           RenderOptions.BitmapScalingMode="Fant"
                           Source="/WinMemoryCleaner;component/Resources/Images/win-memory-cleaner.ico"
                           Width="24" />
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource SoftText}" Text="{Binding Title}" />
                        <TextBlock FontSize="10" Foreground="{StaticResource MutedText}" Text="{Binding VideoAdapterName}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="OnHelpButtonClick"
                            PreviewMouseRightButtonDown="OnHelpButtonPreviewMouseRightButtonDown"
                            Style="{StaticResource WindowButton}"
                            ToolTip="{Binding Path=(local:Localizer.String).Help}"
                            Visibility="{Binding CompactMode, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Visible}}">
                        <Button.Resources>
                            <ContextMenu x:Key="HelpContextMenu">
                                <MenuItem Command="{Binding NavigateUriCommand}"
                                          CommandParameter="{x:Static local:Constants+App+Repository.AboutUri}"
                                          Header="{Binding Path=(local:Localizer.String).About}" />
                                <MenuItem Click="OnResetSettingsToDefaultConfigurationClick"
                                          Header="{Binding Path=(local:Localizer.String).Reset}" />
                                <Separator />
                                <MenuItem Click="OnDonateMenuItemClick"
                                          Header="{Binding Path=(local:Localizer.String).Donate}" />
                            </ContextMenu>
                        </Button.Resources>
                        <TextBlock Text="?" />
                    </Button>
                    <Button Click="OnCompactModeButtonClick"
                            Margin="3,0,0,0"
                            MinWidth="66"
                            Padding="6,0"
                            ToolTip="{Binding Path=(local:Localizer.String).Collapse}">
                        <TextBlock Text="{Binding Path=(local:Localizer.String).Collapse}" />
                    </Button>
                    <Button Click="OnMinimizeButtonClick"
                            Margin="3,0,0,0"
                            Style="{StaticResource WindowButton}"
                            ToolTip="{Binding Path=(local:Localizer.String).Minimize}">
                        <TextBlock FontSize="14" Text="_" />
                    </Button>
                    <Button Click="OnCloseButtonClick"
                            Style="{StaticResource WindowButton}"
                            ToolTip="{Binding Path=(local:Localizer.String).Close}">
                        <TextBlock FontSize="14" Text="X" />
                    </Button>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1"
                        Margin="10,0,8,0"
                        Visibility="{Binding CompactMode, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Visible}}">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,6,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabelText}" Text="CPU" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding CpuUsage, StringFormat={}{0:0}}" />
                                            <TextBlock Foreground="{StaticResource MutedText}" Margin="2,5,0,0" Text="%" />
                                        </StackPanel>
                                        <ProgressBar Maximum="100" Minimum="0" Value="{Binding CpuUsage, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabelText}" Text="RAM" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding RamUsage, StringFormat={}{0:0}}" />
                                            <TextBlock Foreground="{StaticResource MutedText}" Margin="2,5,0,0" Text="%" />
                                        </StackPanel>
                                        <ProgressBar Maximum="100" Minimum="0" Value="{Binding RamUsage, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabelText}" Text="VGA" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding GpuUsage, StringFormat={}{0:0}}" />
                                            <TextBlock Foreground="{StaticResource MutedText}" Margin="2,5,0,0" Text="%" />
                                        </StackPanel>
                                        <ProgressBar Maximum="100" Minimum="0" Value="{Binding GpuUsage, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MetricLabelText}" Text="TEMP" />
                                        <TextBlock Style="{StaticResource MetricValueText}" Text="{Binding TemperatureText}" />
                                        <TextBlock Foreground="{StaticResource MutedText}" Text="ACPI sensor" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="6" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource PanelCard}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SoftText}" Text="{Binding PhysicalMemoryHeader}" />
                                        <ProgressBar Margin="0,6,0,5" Maximum="100" Minimum="0" Value="{Binding Computer.Memory.Physical.Used.Percentage, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding Path=(local:Localizer.String).Used}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Computer.Memory.Physical.Used.Value, Converter={StaticResource StringFormatConverter}, ConverterParameter={}{0:0.#}}" />
                                            <TextBlock Margin="3,0,0,0" Text="{Binding Computer.Memory.Physical.Used.Unit}" />
                                            <TextBlock Foreground="{StaticResource MutedText}" Margin="12,0,0,0" Text="{Binding Path=(local:Localizer.String).Free}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Computer.Memory.Physical.Free.Value, Converter={StaticResource StringFormatConverter}, ConverterParameter={}{0:0.#}}" />
                                            <TextBlock Margin="3,0,0,0" Text="{Binding Computer.Memory.Physical.Free.Unit}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2"
                                        Style="{StaticResource PanelCard}"
                                        Visibility="{Binding ShowVirtualMemory, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Visible}}">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SoftText}" Text="{Binding VirtualMemoryHeader}" />
                                        <ProgressBar Margin="0,6,0,5" Maximum="100" Minimum="0" Value="{Binding Computer.Memory.Virtual.Used.Percentage, Mode=OneWay}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding Path=(local:Localizer.String).Used}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Computer.Memory.Virtual.Used.Value, Converter={StaticResource StringFormatConverter}, ConverterParameter={}{0:0.#}}" />
                                            <TextBlock Margin="3,0,0,0" Text="{Binding Computer.Memory.Virtual.Used.Unit}" />
                                            <TextBlock Foreground="{StaticResource MutedText}" Margin="12,0,0,0" Text="{Binding Path=(local:Localizer.String).Free}" />
                                            <TextBlock Margin="6,0,0,0" Text="{Binding Computer.Memory.Virtual.Free.Value, Converter={StaticResource StringFormatConverter}, ConverterParameter={}{0:0.#}}" />
                                            <TextBlock Margin="3,0,0,0" Text="{Binding Computer.Memory.Virtual.Free.Unit}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Path=(local:Localizer.String).Settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}">
                                <StackPanel>
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="Language" />
                                    <ComboBox ItemsSource="{x:Static local:Localizer.Languages}"
                                              Margin="0,4,0,8"
                                              MouseRightButtonUp="OnComboBoxMouseRightButtonUp"
                                              SelectedValue="{Binding Language}" />
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="Text size" />
                                    <Slider IsSnapToTickEnabled="True"
                                            Margin="0,4,0,0"
                                            Maximum="18"
                                            Minimum="12"
                                            Name="FontSizeSlider"
                                            TickFrequency="1"
                                            Value="{Binding FontSize}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                                <ItemsControl ItemsSource="{Binding SettingItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding Value, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Path=(local:Localizer.String).MemoryAreas}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource PanelCard}">
                                <ItemsControl ItemsSource="{Binding MemoryAreaItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}"
                                                      IsChecked="{Binding Value, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsEnabled}"
                                                      Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource PanelCard}"
                                    Visibility="{Binding Computer.OperatingSystem.HasHotkeyManager, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Collapsed}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource SoftText}" Text="{Binding Path=(local:Localizer.String).OptimizationHotkey}" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding UseHotkey}" VerticalAlignment="Center" />
                                        <ComboBox DisplayMemberPath="Value"
                                                  IsEnabled="{Binding UseHotkey}"
                                                  ItemsSource="{Binding KeyboardModifiers}"
                                                  Margin="6,0,0,0"
                                                  MouseRightButtonUp="OnComboBoxMouseRightButtonUp"
                                                  SelectedValue="{Binding OptimizationModifiers}"
                                                  SelectedValuePath="Key"
                                                  Width="100" />
                                        <TextBlock Margin="6,3" Text="+" />
                                        <ComboBox IsEnabled="{Binding UseHotkey}"
                                                  ItemsSource="{Binding KeyboardKeys}"
                                                  MouseRightButtonUp="OnComboBoxMouseRightButtonUp"
                                                  SelectedValue="{Binding OptimizationKey}"
                                                  Width="88" />
                                    </StackPanel>
                                    <TextBlock Foreground="{DynamicResource MemoryBarIndicatorBackground}"
                                               Margin="0,6,0,0"
                                               Text="{Binding Path=(local:Localizer.String).Invalid}"
                                               Visibility="{Binding IsOptimizationKeyValid, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Collapsed}}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Path=(local:Localizer.String).AutoOptimization}">
                    <Border Margin="0,6,0,0" Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding AutoOptimizationMemoryIntervalDescription}" />
                            <Slider IsSnapToTickEnabled="True"
                                    Margin="0,6,0,10"
                                    Maximum="168"
                                    Minimum="0"
                                    Name="AutoOptimizationIntervalSlider"
                                    TickFrequency="1"
                                    Value="{Binding AutoOptimizationInterval}" />
                            <TextBlock Text="{Binding AutoOptimizationMemoryUsageDescription}" />
                            <Slider IsSnapToTickEnabled="True"
                                    Margin="0,6,0,3"
                                    Maximum="100"
                                    Minimum="0"
                                    Name="AutoOptimizationMemoryUsageSlider"
                                    TickFrequency="1"
                                    ToolTip="{Binding AutoOptimizationMemoryUsageWarning}"
                                    Value="{Binding AutoOptimizationMemoryUsage}" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedText}" Text="{Binding AutoOptimizationMemoryUsageWarning}" />
                        </StackPanel>
                    </Border>
                </TabItem>

                <TabItem Header="{Binding Path=(local:Localizer.String).TrayIcon}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Margin="0,6,0,0" Style="{StaticResource PanelCard}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding TrayIconItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Checked="OnTrayIconItemCheckBoxChecked"
                                                          Content="{Binding Name}"
                                                          IsChecked="{Binding Value, Mode=TwoWay}"
                                                          IsEnabled="{Binding IsEnabled}"
                                                          Margin="0,0,0,4"
                                                          Unchecked="OnTrayIconItemCheckBoxUnchecked" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,3" Text="{Binding Path=(local:Localizer.String).Background}" />
                                    <ComboBox IsEnabled="{Binding TrayIconUseTransparentBackground, Converter={StaticResource InverseBooleanConverter}}"
                                              ItemTemplate="{StaticResource BrushPickerItemTemplate}"
                                              ItemsSource="{Binding Brushes}"
                                              SelectedItem="{Binding TrayIconBackgroundColor, Mode=TwoWay}" />

                                    <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,3" Text="{Binding Path=(local:Localizer.String).Text}" />
                                    <ComboBox ItemTemplate="{StaticResource BrushPickerItemTemplate}"
                                              ItemsSource="{Binding Brushes}"
                                              SelectedItem="{Binding TrayIconTextColor, Mode=TwoWay}" />

                                    <TextBlock Foreground="{StaticResource MutedText}" Margin="0,6,0,3" Text="{Binding Path=(local:Localizer.String).Optimizing}" />
                                    <ComboBox ItemTemplate="{StaticResource BrushPickerItemTemplate}"
                                              ItemsSource="{Binding Brushes}"
                                              SelectedItem="{Binding TrayIconOptimizingColor, Mode=TwoWay}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" IsEnabled="{Binding TrayIconShowMemoryUsage}">
                                    <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding Path=(local:Localizer.String).WarningLevel}" />
                                    <StackPanel Margin="0,3,0,8" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding MemoryUsageThresholds}"
                                                  SelectedItem="{Binding TrayIconWarningLevel, Mode=TwoWay}"
                                                  Width="56" />
                                        <ComboBox ItemTemplate="{StaticResource BrushPickerItemTemplate}"
                                                  ItemsSource="{Binding Brushes}"
                                                  Margin="6,0,0,0"
                                                  SelectedItem="{Binding TrayIconWarningColor, Mode=TwoWay}"
                                                  Width="140" />
                                    </StackPanel>

                                    <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding Path=(local:Localizer.String).DangerLevel}" />
                                    <StackPanel Margin="0,3,0,0" Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding MemoryUsageThresholds}"
                                                  SelectedItem="{Binding TrayIconDangerLevel, Mode=TwoWay}"
                                                  Width="56" />
                                        <ComboBox ItemTemplate="{StaticResource BrushPickerItemTemplate}"
                                                  ItemsSource="{Binding Brushes}"
                                                  Margin="6,0,0,0"
                                                  SelectedItem="{Binding TrayIconDangerColor, Mode=TwoWay}"
                                                  Width="140" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{Binding Path=(local:Localizer.String).ProcessExclusionList}">
                    <Border Margin="0,6,0,0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollViewer Name="ProcessExclusionScrollViewer" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ProcessExclusionList}" Name="ProcessExclusionList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Foreground="{StaticResource SoftText}" Text="{Binding}" VerticalAlignment="Center" />
                                                <Button Command="{Binding MainViewModel.RemoveProcessFromExclusionListCommand, Source={StaticResource ViewModelLocator}}"
                                                        CommandParameter="{Binding}"
                                                        Content="{Binding Path=(local:Localizer.String).Remove}"
                                                        Grid.Column="1"
                                                        Padding="6,2" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Grid Grid.Row="1" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox DropDownOpened="OnProcessesDropDownOpened"
                                          ItemsSource="{Binding Processes}"
                                          MouseRightButtonUp="OnComboBoxMouseRightButtonUp"
                                          SelectedValue="{Binding SelectedProcess}" />
                                <Button Command="{Binding AddProcessToExclusionListCommand}"
                                        CommandParameter="{Binding SelectedProcess}"
                                        Content="{Binding Path=(local:Localizer.String).Add}"
                                        Grid.Column="2"
                                        Padding="10,2" />
                            </Grid>
                        </Grid>
                    </Border>
                </TabItem>
            </TabControl>

            <Border Grid.Row="2"
                    Background="{StaticResource PanelBackgroundAlt}"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1,1,0,0"
                    CornerRadius="0,0,8,8"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="{StaticResource MutedText}" Text="{Binding PhysicalMemoryHeader}" />
                        <ProgressBar Margin="0,5,0,0"
                                     Maximum="100"
                                     Minimum="0"
                                     Value="{Binding Computer.Memory.Physical.Used.Percentage, Mode=OneWay}" />
                        <CheckBox Content="{Binding Path=(local:Localizer.String).RunOnStartup}"
                                  IsChecked="{Binding RunOnStartup}"
                                  IsEnabled="{Binding CanRunOnStartup}"
                                  Margin="0,6,0,0"
                                  ToolTip="{Binding Path=(local:Localizer.String).RunOnStartup}" />
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Button Command="{Binding OptimizeCommand}"
                                Content="{Binding Path=(local:Localizer.String).Optimize}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Name="Optimize"
                                Padding="8,5"
                                Style="{StaticResource ButtonWithFocusFadeStyle}" />
                        <Grid Visibility="{Binding IsOptimizationRunning, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue={x:Static Visibility.Hidden}}">
                            <ProgressBar BorderBrush="{DynamicResource Accent}"
                                         BorderThickness="1"
                                         Maximum="{Binding OptimizationProgressTotal}"
                                         Minimum="0"
                                         Value="{Binding OptimizationProgressValue, Mode=OneWay}" />
                            <TextBlock Foreground="{StaticResource SoftText}"
                                       HorizontalAlignment="Center"
                                       Text="{Binding OptimizationProgressStep}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</local:View>
